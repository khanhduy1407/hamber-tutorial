<script>
	import Header from './components/Header.hamber';
	import Footer from './components/Footer.hamber';
	import Tabs from './shared/Tabs.hamber';

	// tabs
	let items = ["Current Polls", "Add New Poll"];
	let activeItem = "Current Polls";

	const tabChange = (e) => {
		activeItem = e.detail;
	}
</script>

<Header />

<main>
	<Tabs {items} {activeItem} on:tabChange={tabChange} />
	{#if activeItem === "Current Polls"}
		<p>Poll list component goes here</p>
	{:else if activeItem === "Add New Poll"}
		<p>New poll form component goes here</p>
	{/if}
</main>

<Footer />

<style>
	main {
		max-width: 960px;
		margin: 40px auto;
	}
</style>